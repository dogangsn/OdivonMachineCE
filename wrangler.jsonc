{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odivon-machine-ce",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/OdivonMachineCE/browser",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "machinece.odivon.com",
      "custom_domain": true
    }
  ]
}
